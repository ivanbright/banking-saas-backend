<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Database connection settings -->
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/bankingdb</property>
        <property name="hibernate.connection.username">postgres</property>
        <property name="hibernate.connection.password">mysecretpassword</property>

        <!-- Connection pool settings -->
        <property name="hibernate.c3p0.min_size">5</property>
        <property name="hibernate.c3p0.max_size">20</property>
        <property name="hibernate.c3p0.timeout">300</property>
        <property name="hibernate.c3p0.max_statements">50</property>
        <property name="hibernate.c3p0.idle_test_period">3000</property>

        <!-- SQL dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>

        <!-- Echo all executed SQL to stdout -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.use_sql_comments">true</property>

        <!-- Update the database schema on startup -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Batch processing -->
        <property name="hibernate.jdbc.batch_size">20</property>
        <property name="hibernate.order_inserts">true</property>
        <property name="hibernate.order_updates">true</property>
        <property name="hibernate.jdbc.batch_versioned_data">true</property>

        <!-- Second-level cache -->
        <property name="hibernate.cache.use_second_level_cache">true</property>
        <property name="hibernate.cache.use_query_cache">true</property>
        <property name="hibernate.cache.region.factory_class">org.hibernate.cache.jcache.JCacheRegionFactory</property>

        <!-- Statistics -->
        <property name="hibernate.generate_statistics">false</property>

        <!-- Entity mappings -->
        <mapping class="com.mugisha.bankingbackend.model.User"/>
        <mapping class="com.mugisha.bankingbackend.model.Account"/>
        <mapping class="com.mugisha.bankingbackend.model.Transaction"/>
        <mapping class="com.mugisha.bankingbackend.model.Card"/>
        <mapping class="com.mugisha.bankingbackend.model.Loan"/>
        <mapping class="com.mugisha.bankingbackend.model.Beneficiary"/>
        <mapping class="com.mugisha.bankingbackend.model.Transfer"/>
        <mapping class="com.mugisha.bankingbackend.model.Branch"/>
        <mapping class="com.mugisha.bankingbackend.model.Employee"/>
        <mapping class="com.mugisha.bankingbackend.model.SupportTicket"/>
        <mapping class="com.mugisha.bankingbackend.model.TicketMessage"/>
        <mapping class="com.mugisha.bankingbackend.model.AuditLog"/>
        <mapping class="com.mugisha.bankingbackend.model.Notification"/>

    </session-factory>
</hibernate-configuration>
